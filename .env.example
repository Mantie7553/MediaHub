# MediaHub Docker config. install.sh / install.ps1 create .env from this file and fill in the
# secrets; you only need to edit it by hand to change a setting later (then run the update script).

# ---- where your media lives ----
# Folder on this machine that holds TV Shows/, Movies/, Music/, Manga/, Light Novels/
MEDIA_HOST_PATH=/mnt/nas/Media
# The same folder as the containers see it. Keep it equal to MEDIA_HOST_PATH on Linux so file
# paths already stored in the database stay valid; on Windows use /media
MEDIA_ROOT=/mnt/nas/Media

# Media on an SMB/NAS share instead of a local folder: add docker-compose.smb.yml to COMPOSE_FILE
SMB_HOST=
SMB_SHARE=
SMB_USERNAME=
SMB_PASSWORD=

# ---- web access ----
# The address people open MediaHub at (CORS origin), e.g. https://media.example.com
PUBLIC_URL=http://localhost
HTTP_PORT=80
# Remote access through Cloudflare, pick one in COMPOSE_PROFILES:
#  - tunnel:      named tunnel on your own domain (Zero Trust > Networks > Tunnels). Point its
#                 public hostname at http://web:80 and paste the token here
#  - quicktunnel: no domain or account needed; a random https://….trycloudflare.com address that
#                 changes when the tunnel restarts. ./tunnel-url.sh (.ps1) prints the current one
TUNNEL_TOKEN=

# ---- compose ----
# Linux with a GPU: docker-compose.yml:docker-compose.gpu.yml. NAS share: add :docker-compose.smb.yml
COMPOSE_FILE=docker-compose.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_PROFILES=
# Image tag to run. latest follows main; set sha-<commit> to pin or roll back
MEDIAHUB_TAG=latest
# Seconds between checks for new MediaHub images
UPDATE_INTERVAL=300

# Hour (0-23, in TZ) MediaHub syncs its library from Sonarr, Radarr and the media folders every
# night; "off" disables it. Admins can also run it from Management > Library Sync
LIBRARY_SYNC_HOUR=4

# ---- system ----
TZ=Etc/UTC
PUID=1000
PGID=1000
# group id of "render" on the host, only used with docker-compose.gpu.yml
RENDER_GID=

# ---- secrets (generated by the install script) ----
DB_USER=mediahub
DB_NAME=mediahub
DB_PASSWORD=
JWT_SECRET=
MEDIA_SIGNING_SECRET=
WEBHOOK_SECRET=
# replaces the default admin password on first start; changing it later has no effect
ADMIN_PASSWORD=
# login for the qBittorrent, Sonarr, Radarr and Prowlarr web UIs (user: admin)
ARR_PASSWORD=
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=

# Cloudflare Tunnel (or the LAN) talks plain HTTP to this; TLS ends at Cloudflare
{
	auto_https off
	admin off

	servers {
		# cloudflared reaches Caddy from the Docker network, so requests from private addresses
		# may say who the real client is: Cloudflare's Cf-Connecting-Ip, or X-Forwarded-For.
		# Without this every tunnel visitor looks like cloudflared and they all share one login
		# rate limit. LAN devices are trusted the same way
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	header {
		# what the page may load: its own scripts only, so injected markup can't run code.
		# Images come from AniList and YouTube too, fonts from Google, and video, audio and
		# manga pages use blob: URLs
		Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# media tokens ride in URLs, so other sites are never told which page linked to them
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# browsers only act on this over HTTPS (through Cloudflare); plain http on the LAN ignores it
		Strict-Transport-Security "max-age=15552000"
		-Server
	}

	handle /api/* {
		# no buffering so HLS playlists and SSE progress reach the browser immediately
		reverse_proxy backend:9090 {
			flush_interval -1
			# the backend rate limits by this; Caddy always overwrites what the client sent
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		root * /srv
		# Vite puts a content hash in every file name under /assets, so a new build gets new
		# names: those can be kept for good. Anything else (index.html, the icons) is checked
		# each load so a deploy shows up straight away
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
